# ---- Jira connection ----
# Your Atlassian site base URL (no trailing slash)
JIRA_BASE_URL=https://team-anervea.atlassian.net

# The email tied to your Atlassian account
JIRA_EMAIL=rhidzkhan.ahmad@anervea.ai

# Personal API token. Create one at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Paste the token value here. (This file is .env.example — copy to .env and fill the real value.)
JIRA_API_TOKEN=your-api-token-here

# Jira project key to sync (the board NEX / "Nexus Project")
JIRA_PROJECT=NEX

# ---- Local storage ----
# SQLite database file (relative to project root)
DATABASE_URL=sqlite:///./jira_tracker.db

# ---- CORS (React dev servers allowed to call this API) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Reporting ----
# Timezone used to bucket movement reports into days/weeks (IANA name).
REPORT_TIMEZONE=Asia/Manila

# Comma-separated mover names excluded from movement reports (Jira bots).
REPORT_EXCLUDE_MOVERS=Automation for Jira

# ---- Sprint-comparison deck ----
# Report-time allow-list: the closure/kickoff deck only counts these people
# (must match Jira displayName exactly). Independent of MONITOR_ASSIGNEES.
REPORT_ASSIGNEES=Dan Denver De Leon,Dan Rudolf,Deinielle Cruz,Allen Mathew Cordero,Shane Michael Singwa,Sidney Buenaventura

# Statuses that count as "completed" in the reports. This team ships finished dev
# work to "Merged" (not "Done"), so Merged counts; QA Testing is excluded (still
# under test). Comma-separated, matched against the Jira status name.
REPORT_DONE_STATUSES=Done,Deployment,Merged

# ---- Weekly QA activity report ----
# Allow-list of QA engineers for the weekly deck. Empty = everyone who moved a
# ticket that week (minus bots). Comma-separated.
QA_REPORT_ASSIGNEES=
# Jira labels that flag a ticket's QA outcome (case-insensitive). QA_PASSED counts a
# ticket as moved-forward; QA_FAILED marks it sent back to Dev after failing QA.
QA_PASSED_LABEL=QA_PASSED
QA_FAILED_LABEL=QA_FAILED
# "What we need from leadership" asks — JSON array of {ask,owner,why,needed_by}.
# Rendered verbatim into the deck. Can also be passed per-request via ?asks=.
QA_REPORT_ASKS=[]

# ---- LLM (for the PPTX slide narrative) ----
# API key from https://console.anthropic.com (NOT your Claude subscription login).
# Without it, the .pptx endpoint returns 503; the HTML deck + JSON still work.
ANTHROPIC_API_KEY=
REPORT_LLM_MODEL=claude-opus-4-8
